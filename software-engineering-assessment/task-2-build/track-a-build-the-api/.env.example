# ─────────────────────────────────────────────────────────────────────────────
# Fenwick & Co. storefront — environment contract
#
# Every variable here has a working development default baked into
# docker-compose.yml, so `docker compose up` works on a clean clone with no
# manual step. Copy this file to `.env` only when you want to override one.
#
#     cp .env.example .env
#
# The defaults are DEVELOPMENT values. Nothing here is a real secret, and
# nothing here should ever reach a deployed environment: JWT_SECRET and the
# database password must come from the platform's secret store in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storefront (nginx: static SPA + reverse proxy) ───────────────────────────
# Injected into the browser at container start as window.APP_CONFIG.apiBaseUrl.
# A same-origin PATH, not a host URL: nginx receives every request and proxies
# /api to the API, so the browser never makes a cross-origin call.
API_BASE_URL=/api
STOREFRONT_PORT=8080

# ── API (NestJS) ─────────────────────────────────────────────────────────────
# Listens on 3000 INSIDE the compose network and is deliberately not published
# on the host: nginx is the only entrance. Reach it directly for debugging with
# `docker compose exec api ...`.
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# No CORS_ORIGIN: the storefront calls /api on its own origin, so there is no
# cross-origin request to permit. CORS stays off rather than being set to "*".
# Development value only.
JWT_SECRET=dev-only-not-a-real-secret-change-me
SESSION_TTL_SECONDS=86400

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=fenwick
POSTGRES_PASSWORD=fenwick
POSTGRES_DB=fenwick
# Host-side port only. Containers always reach the database at db:5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fenwick:fenwick@db:5432/fenwick?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# Sessions and the POST /orders idempotency keys.
REDIS_PORT=6379
REDIS_URL=redis://cache:6379

# ── Payments gateway (provided mock) ─────────────────────────────────────────
PAYMENTS_PORT=9090
PAYMENTS_URL=http://payments:9090
# Deliberately longer than the storefront's own 8s abort. Test card
# 4000 0000 0000 0069 takes ~9s to settle: the browser gives up first and
# retries with the same X-Request-Id, so the API must be able to finish the
# charge it already started rather than abandon it and start a second one.
PAYMENTS_TIMEOUT_MS=15000
