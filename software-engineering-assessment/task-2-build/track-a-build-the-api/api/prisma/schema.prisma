generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catalog, coupons, and per-user carts. Money is DECIMAL(12,2); line prices
// are never stored — GET /cart reads Product.price so the catalog stays
// the single source of truth.

model User {
  id           String @id
  username     String @unique
  passwordHash String @map("password_hash")
  displayName  String @map("display_name")
  cart         Cart?

  @@map("users")
}

model Product {
  id          String     @id
  sku         String     @unique
  name        String
  category    String
  price       Decimal    @db.Decimal(12, 2)
  stock       Int
  imageUrl    String     @map("image_url")
  description String
  cartItems   CartItem[]

  @@map("products")
}

enum CouponType {
  percent
  amount
}

model Coupon {
  code           String     @id
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  minOrder       Decimal?   @map("min_order") @db.Decimal(12, 2)
  maxRedemptions Int?       @map("max_redemptions")
  perUserLimit   Int?       @map("per_user_limit")
  expiresAt      DateTime?  @map("expires_at")
  carts          Cart[]

  @@map("coupons")
}

model Cart {
  userId     String     @id @map("user_id")
  couponCode String?    @map("coupon_code")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon     Coupon?    @relation(fields: [couponCode], references: [code], onDelete: SetNull)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id
  userId    String  @map("user_id")
  productId String  @map("product_id")
  quantity  Int
  cart      Cart    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_items")
}
