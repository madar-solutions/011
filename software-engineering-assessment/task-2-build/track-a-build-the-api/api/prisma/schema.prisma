generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catalog tables exist so api-migrate can apply a real schema and load seed.json.
// HTTP routes for these records are a later commit — this one only proves the
// pipeline: migrate deploy, seed, then the API process answering /health.

model User {
  id           String @id
  username     String @unique
  passwordHash String @map("password_hash")
  displayName  String @map("display_name")

  @@map("users")
}

model Product {
  id          String  @id
  sku         String  @unique
  name        String
  category    String
  price       Decimal @db.Decimal(12, 2)
  stock       Int
  imageUrl    String  @map("image_url")
  description String

  @@map("products")
}

enum CouponType {
  percent
  amount
}

model Coupon {
  code           String     @id
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  minOrder       Decimal?   @map("min_order") @db.Decimal(12, 2)
  maxRedemptions Int?       @map("max_redemptions")
  perUserLimit   Int?       @map("per_user_limit")
  expiresAt      DateTime?  @map("expires_at")

  @@map("coupons")
}
